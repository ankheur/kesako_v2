{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "algolia/scout-extended": "^3.0",
        "chiiya/filament-access-control": "^2.3",
        "coderflexx/laravisit": "^1.4.2",
        "filament/filament": "^3.1.27",
        "guzzlehttp/guzzle": "^7.8.1",
        "jeffgreco13/filament-breezy": "^2.2.1.1",
        "laravel/framework": "^10.38.2",
        "laravel/sanctum": "^3.3.2",
        "laravel/scout": "^10.6.1",
        "laravel/tinker": "^2.8.2",
        "opcodesio/log-viewer": "^3.1.10",
        "ralphjsmit/laravel-filament-seo": "^1.2",
        "spatie/laravel-sitemap": "^7.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "fakerphp/faker": "^1.23.0",
        "laravel-lang/common": "^5.4.0",
        "laravel/pint": "^1.13.7",
        "laravel/sail": "^1.26.3",
        "mockery/mockery": "^1.6.7",
        "nunomaduro/collision": "^7.10",
        "larastan/larastan": "^2.7",
        "nunomaduro/patrol": "^1.2",
        "pestphp/pest": "^2.28.1",
        "pestphp/pest-plugin-faker": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.2",
        "pestphp/pest-plugin-livewire": "^2.1",
        "phpunit/phpunit": "^10.5.3",
        "roave/security-advisories": "dev-latest",
        "spatie/laravel-ignition": "^2.3.3",
        "tightenco/duster": "^2.7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
